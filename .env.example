# Firebase Client Config (public)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Admin SDK (server-side only - never expose these)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Cloudflare R2 Storage (server-side only - never expose these)
CLOUDFLARE_R2_ACCOUNT_ID=your_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=restaurant-media

# R2 public URL — use the r2.dev URL from your bucket's public access settings
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
# Optional: if you connect a custom domain to R2 (e.g. media.yourrestaurant.com)
# NEXT_PUBLIC_R2_PUBLIC_DOMAIN=media.yourrestaurant.com

# App Config
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Initial Developer Account (used by /api/setup on first run)
INITIAL_DEV_EMAIL=developer@restaurant.com
INITIAL_DEV_PASSWORD=ChangeMe2025!
INITIAL_DEV_NAME=Developer
